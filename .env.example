SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Set to "true" to write fares to ./out/fares-*.json instead of Supabase.
# Useful for local testing before the flight_routes table exists.
DRY_RUN=false

# Aeroglobe credentials. The scraper first looks for these in the Supabase
# flight_scraper_config table (admin-managed via /admin); these env vars are
# the fallback when that row doesn't exist or is missing fields.
AEROGLOBE_EMAIL=
AEROGLOBE_PASSWORD=
